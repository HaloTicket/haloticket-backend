# PostgreSQL Database Configuration
POSTGRES_USER=haloticket
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_PORT=5433

# Redis Cache & Distributed Locking
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379

# Apache Kafka (KRaft Mode)
KAFKA_PORT=9092
KAFKA_HOST=localhost
KAFKA_CLUSTER_ID=haloticket-cluster-123

# Notification service SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com
SMTP_AUTH=true
SMTP_STARTTLS=true

# Keycloak Identity & Access Management (IAM)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password_here
KEYCLOAK_PORT=9080
KEYCLOAK_REALM=haloticket-realm
KEYCLOAK_CLIENT_ID=user-service
KEYCLOAK_CLIENT_SECRET=user-service-secret

# Production Deployment Settings for Keycloak
KEYCLOAK_HOSTNAME=
KEYCLOAK_HOSTNAME_STRICT=false
KC_PROXY_HEADERS=xforwarded

# Google OAuth2 Identity Provider (used by the haloticket-web public client)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# pgAdmin 4 (Observability UI for PostgreSQL)
PGADMIN_DEFAULT_EMAIL=admin@haloticket.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password_here
PGADMIN_PORT=5050

# Kafka-UI (Observability UI for Kafka Topics & Consumers)
KAFKA_UI_PORT=9090

# RedisInsight (Observability UI for Redis Cache & Keys)
REDIS_INSIGHT_PORT=5540

# Container backend (manual Java services keep their localhost defaults)
IMAGE_TAG=local
KEYCLOAK_PUBLIC_URL=http://localhost:9080
KEYCLOAK_COMMAND=start-dev
INFRA_BIND_ADDRESS=127.0.0.1
KEYCLOAK_BIND_ADDRESS=127.0.0.1
GATEWAY_BIND_ADDRESS=127.0.0.1
SERVICE_BIND_ADDRESS=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174
SERVICE_MEMORY_LIMIT=512m
SERVICE_CPU_LIMIT=1.0
DB_POOL_SIZE=5
POSTGRES_MEMORY_LIMIT=512m
REDIS_MEMORY_LIMIT=192m
KAFKA_MEMORY_LIMIT=768m
KEYCLOAK_MEMORY_LIMIT=768m
KAFKA_LOG_RETENTION_HOURS=168
AUTH_OTP_PEPPER=replace-with-a-long-random-secret

# Media service: set real S3 credentials for uploads.
AWS_S3_BUCKET=haloticket-media-bucket
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_ENDPOINT=
# VNPT eKYC: backend only. Do not expose through VITE_* variables.
VNPT_EKYC_ENABLED=false
VNPT_EKYC_BASE_URL=https://api.idg.vnpt.vn
VNPT_EKYC_TOKEN_ID=
VNPT_EKYC_TOKEN_KEY=
VNPT_EKYC_ACCESS_TOKEN=
EKYC_FINGERPRINT_SECRET=
