# =================================================================
# HaloTicket Infrastructure Environment Variables Template
# 
# Instructions:
# 1. Copy this template file to create your local .env file:
#    - Windows (PowerShell): copy .env.example .env
#    - Linux / macOS:        cp .env.example .env
# 2. Modify the placeholder values below to match your local setup.
# 3. DO NOT commit your actual .env file to version control.
# =================================================================

# -----------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------
POSTGRES_USER=haloticket
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_PORT=5433

# -----------------------------------------------------------------
# Redis Cache & Distributed Locking
# -----------------------------------------------------------------
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379

# -----------------------------------------------------------------
# Apache Kafka (KRaft Mode)
# -----------------------------------------------------------------
KAFKA_PORT=9092
KAFKA_CLUSTER_ID=haloticket-cluster-123

# -----------------------------------------------------------------
# Keycloak Identity & Access Management (IAM)
# -----------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password_here
KEYCLOAK_PORT=9080
KEYCLOAK_REALM=haloticket-realm
KEYCLOAK_CLIENT_ID=user-service
KEYCLOAK_CLIENT_SECRET=user-service-secret

# -----------------------------------------------------------------
# pgAdmin 4 (Observability UI for PostgreSQL)
# -----------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@haloticket.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password_here
PGADMIN_PORT=5050

# -----------------------------------------------------------------
# Kafka-UI (Observability UI for Kafka Topics & Consumers)
# -----------------------------------------------------------------
KAFKA_UI_PORT=9090

# -----------------------------------------------------------------
# RedisInsight (Observability UI for Redis Cache & Keys)
# -----------------------------------------------------------------
REDIS_INSIGHT_PORT=5540
